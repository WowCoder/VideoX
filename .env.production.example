# 复制为 .env.production，设置权限 chmod 600，并替换所有 CHANGE_ME 值。
# 部署脚本通过 VIDEOX_ENV_FILE 指定该文件；不要提交真实生产配置。

ENVIRONMENT=production
VIDEOX_IMAGE_TAG=latest
VIDEOX_BACKEND_IMAGE=videox-backend
VIDEOX_GATEWAY_IMAGE=videox-gateway
VIDEOX_ADMIN_GATEWAY_IMAGE=videox-admin-gateway
# 可选：服务器访问官方 Debian/PyPI/npm 较慢时，仅在构建命令中导出这些值。
VIDEOX_APT_MIRROR=
VIDEOX_PIP_INDEX_URL=
VIDEOX_NPM_REGISTRY=

# 雷池指向 GATEWAY_BIND_IP:GATEWAY_PORT。默认仅绑定宿主机回环地址；
# 若雷池运行在 Docker 容器且无法访问回环地址，改为服务器内网 IP，并用防火墙仅允许雷池访问。
GATEWAY_BIND_IP=127.0.0.1
GATEWAY_PORT=8080
ADMIN_GATEWAY_BIND_IP=127.0.0.1
ADMIN_GATEWAY_PORT=8081
APP_DOMAIN=app.example.com
ADMIN_DOMAIN=admin.example.com
MEDIA_DOMAIN=media.example.com

POSTGRES_USER=videox
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
POSTGRES_DB=videox
DATABASE_URL=postgresql+asyncpg://videox:CHANGE_ME_DATABASE_PASSWORD@db:5432/videox
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0
CELERY_TASK_DEFAULT_QUEUE=videox-production
CELERY_WORKER_CONCURRENCY=1

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
MINIO_BUCKET=videox-media
MINIO_SECURE=false
MINIO_PUBLIC_ENDPOINT=media.example.com
MINIO_PUBLIC_SECURE=true
MINIO_UPLOAD_PART_SIZE_MB=16
MAX_UPLOAD_SIZE_GB=1

JWT_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS_LONG
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7
ADMIN_JWT_SECRET=CHANGE_ME_DIFFERENT_32_RANDOM_CHARACTERS_LONG
ADMIN_MFA_ENCRYPTION_KEY=CHANGE_ME_ANOTHER_32_RANDOM_CHARACTERS_LONG
ADMIN_ACCESS_EXPIRE_MINUTES=15
ADMIN_SESSION_EXPIRE_DAYS=7
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_LOCK_MINUTES=15
ADMIN_REFRESH_COOKIE_NAME=videox_admin_refresh
HOST_METRICS_PATH=/srv/videox/.host-metrics
SYSTEM_METRICS_ENABLED=true
SYSTEM_METRICS_NODE_NAME=primary
SYSTEM_METRICS_DISK_PATH=/host-metrics-disk
SYSTEM_METRICS_SCOPE=host
SYSTEM_METRICS_RETENTION_DAYS=30
SYSTEM_METRICS_MANUAL_MIN_INTERVAL_SECONDS=30
CORS_ORIGINS=https://app.example.com,https://admin.example.com
TRUSTED_HOSTS=app.example.com,admin.example.com,backend,127.0.0.1,localhost
RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=20
UPLOAD_RATE_LIMIT_PER_MINUTE=30

# 未准备本地 AI 时，将本地 Provider 改为 disabled；不会自动回退到付费线上模型。
AI_EMBEDDING_PROVIDER=disabled
AI_RERANK_PROVIDER=disabled
AI_ASR_PROVIDER=disabled
AI_OCR_PROVIDER=disabled
LOCAL_AI_API_KEY=CHANGE_ME_AT_LEAST_24_RANDOM_CHARACTERS
LOCAL_AI_TIMEOUT_SECONDS=600
LOCAL_EMBEDDING_URL=http://local-embedding:8000
LOCAL_RERANK_URL=http://local-reranker:8000
LOCAL_ASR_URL=http://local-asr:8000
LOCAL_OCR_URL=http://local-ocr:8000
LOCAL_AI_DEVICE=cpu
LOCAL_MODEL_SOURCE=modelscope
AI_EMBEDDING_MODEL=BAAI/bge-m3
AI_EMBEDDING_DIMENSIONS=1024
AI_RERANK_MODEL=BAAI/bge-reranker-v2-m3
AI_ASR_MODEL=paraformer-zh
AI_OCR_MODEL=PP-OCRv4-ONNX
AI_MATCH_CANDIDATE_LIMIT=20
AI_MATCH_RESULT_LIMIT=5

DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_POLL_INTERVAL_SECONDS=2
DASHSCOPE_GENERATION_TIMEOUT_SECONDS=600
# 在线生成式能力可分别选择 dashscope / agnes / disabled。
AI_TEXT_PROVIDER=disabled
AI_VISION_PROVIDER=disabled
AI_IMAGE_PROVIDER=disabled
AI_TEXT_TO_VIDEO_PROVIDER=disabled
AI_IMAGE_TO_VIDEO_PROVIDER=disabled
AI_TEXT_MODEL=qwen-plus
AI_VISION_MODEL=qwen-vl-plus
AI_IMAGE_MODEL=wanx2.1-t2i-turbo
AI_TEXT_TO_VIDEO_MODEL=wanx2.1-t2v-turbo
AI_IMAGE_TO_VIDEO_MODEL=wan2.7-i2v-2026-04-25

# 灵感岛联网发现。bing-rss 不需要 API Key；设为 disabled 可完全关闭全网搜索。
WEB_SEARCH_PROVIDER=bing-rss
WEB_SEARCH_URL=https://www.bing.com/search
WEB_SEARCH_TIMEOUT_SECONDS=20
WEB_SEARCH_RESULTS_PER_QUERY=8
INSPIRATION_SEARCH_CANDIDATE_LIMIT=18
INSPIRATION_PROMPT_CHARACTER_BUDGET=80000

AI_EFFECT_VIDEO_PROVIDER=disabled
AI_EFFECT_VIDEO_MODEL=wan2.7-i2v-2026-04-25
# 配音当前支持 dashscope / disabled；Agnes 暂无 TTS Provider 实现。
AI_TTS_PROVIDER=disabled
AI_TTS_MODEL=qwen-audio-3.0-tts-flash
AI_TTS_VOICE=longanfengyue
AI_TTS_LANGUAGE=Chinese
AI_TTS_REQUEST_TIMEOUT_SECONDS=120
AI_TTS_DOWNLOAD_TIMEOUT_SECONDS=120
AI_TTS_MAX_TEXT_CHARACTERS=1000
AI_TTS_OUTPUT_SAMPLE_RATE=48000
AI_TTS_OUTPUT_CHANNELS=2
AI_TTS_AUTO_TIME_STRETCH_LIMIT=1.12
AI_VIDEO_RESOLUTION=720P
AI_VIDEO_DURATION_SECONDS=5
AI_VIDEO_PROMPT_EXTEND=true
AI_VIDEO_WATERMARK=false
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3
DASHSCOPE_ASR_MODEL=paraformer-v2
DASHSCOPE_OCR_MODEL=qwen-vl-ocr
# Agnes AI 中国站文档：https://www.agnes-ai.cn/zh-Hans/docs/overview
AGNES_API_KEY=
AGNES_BASE_URL=https://api.agnes-ai.cn/v1
AGNES_POLL_INTERVAL_SECONDS=2
AGNES_GENERATION_TIMEOUT_SECONDS=600
AGNES_VIDEO_SUBMIT_INTERVAL_SECONDS=61
AGNES_VIDEO_SUBMIT_MAX_ATTEMPTS=4
AGNES_VIDEO_SUBMIT_RETRY_SECONDS=2
AGNES_TEXT_MODEL=agnes-2.5-flash
AGNES_VISION_MODEL=agnes-2.5-flash
AGNES_IMAGE_MODEL=agnes-image-2.1-flash
AGNES_VIDEO_MODEL=agnes-video-2.5-flash
AI_MEDIA_ALLOWED_HOSTS=.aliyuncs.com,.aliyun.com,.agnes-ai.cn,.agnes-ai.space

WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=https://app.example.com/auth/wechat/callback
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
SMS_CODE_TTL_SECONDS=300
SMS_RESEND_INTERVAL_SECONDS=60
SMS_HOURLY_LIMIT=5
SMS_DAILY_LIMIT=10
SMS_MAX_VERIFY_ATTEMPTS=5
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_SANDBOX=false
ALIPAY_NOTIFY_URL=https://app.example.com/api/billing/alipay/notify
ALIPAY_RETURN_URL=https://app.example.com/workspace/account

FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
SUBTITLE_FONT_PATH=
