# ════════════════════════════════════════════════
# OpenVMA 环境变量配置
# 复制本文件为 .env，填入对应凭证后即可启用功能
# 未配置的项将自动降级或返回提示
# ════════════════════════════════════════════════

# ── AI Provider：本地基础能力 ──
# 推荐使用 docker compose --profile local-ai up -d 启动以下真实本地模型服务。
# Provider 可选 local / dashscope / disabled；不会从本地静默回退到线上付费调用。
AI_EMBEDDING_PROVIDER=local
AI_RERANK_PROVIDER=local
AI_ASR_PROVIDER=local
AI_OCR_PROVIDER=local
AI_VISION_PROVIDER=dashscope
LOCAL_AI_API_KEY=
LOCAL_AI_TIMEOUT_SECONDS=600
LOCAL_EMBEDDING_URL=http://localhost:8001
LOCAL_RERANK_URL=http://localhost:8002
LOCAL_ASR_URL=http://localhost:8003
LOCAL_OCR_URL=http://localhost:8004
LOCAL_AI_DEVICE=cpu
# 中国大陆默认使用 ModelScope 下载 BGE 权重；可改为 huggingface。
LOCAL_MODEL_SOURCE=modelscope

# BGE-M3 与当前 pgvector 字段均为 1024 维；切换模型后必须重建全部历史向量。
AI_EMBEDDING_MODEL=BAAI/bge-m3
AI_EMBEDDING_DIMENSIONS=1024
AI_RERANK_MODEL=BAAI/bge-reranker-v2-m3
AI_ASR_MODEL=paraformer-zh
# Apple Silicon 默认使用 PP-OCR ONNX 运行时；Linux GPU 可自行替换为官方 PaddleOCR 服务。
AI_OCR_MODEL=PP-OCRv4-ONNX
AI_MATCH_CANDIDATE_LIMIT=20
AI_MATCH_RESULT_LIMIT=5

# ── 在线生成式 AI Provider ──
# 文本、视觉、生图、文生视频、图生视频均可分别选择 dashscope / agnes / disabled。
# 切换 Provider 只改以下五项；两家的 Key 和模型配置可以同时保留。
AI_TEXT_PROVIDER=dashscope
AI_VISION_PROVIDER=dashscope
AI_IMAGE_PROVIDER=dashscope
AI_TEXT_TO_VIDEO_PROVIDER=dashscope
AI_IMAGE_TO_VIDEO_PROVIDER=dashscope

# ── 阿里千问 DashScope API ──
# 获取地址：https://dashscope.console.aliyun.com/apiKey
# 一个 Key 可以调用多个已开通模型，但各模型分别计费、限流。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_POLL_INTERVAL_SECONDS=2
DASHSCOPE_GENERATION_TIMEOUT_SECONDS=600
AI_TEXT_MODEL=qwen-plus
AI_VISION_MODEL=qwen-vl-plus
AI_IMAGE_MODEL=wanx2.1-t2i-turbo
AI_TEXT_TO_VIDEO_MODEL=wanx2.1-t2v-turbo
# 图生视频和示意草图视频使用已验证可调用的万相 2.7 首帧生视频模型。
AI_IMAGE_TO_VIDEO_MODEL=wan2.7-i2v-2026-04-25
AI_EFFECT_VIDEO_PROVIDER=dashscope
AI_EFFECT_VIDEO_MODEL=wan2.7-i2v-2026-04-25
AI_VIDEO_RESOLUTION=720P
AI_VIDEO_DURATION_SECONDS=5
AI_VIDEO_PROMPT_EXTEND=true
AI_VIDEO_WATERMARK=false

# 仅在显式把基础能力切回 dashscope 时使用。
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3
DASHSCOPE_ASR_MODEL=paraformer-v2
DASHSCOPE_OCR_MODEL=qwen-vl-ocr

# ── Agnes AI 中国站 ──
# 文档：https://www.agnes-ai.cn/zh-Hans/docs/overview
# API：https://api.agnes-ai.cn/v1
# Agnes 视觉理解要求 MINIO_PUBLIC_ENDPOINT 是公网 HTTPS 域名；图生视频
# 会自动通过 Agnes 图生图接口中转私有首帧，因此不依赖公网 MinIO。
AGNES_API_KEY=
AGNES_BASE_URL=https://api.agnes-ai.cn/v1
AGNES_POLL_INTERVAL_SECONDS=2
AGNES_GENERATION_TIMEOUT_SECONDS=600
# 中国站文档当前现价为 ¥0 的模型；价格可能变化，升级前请重新核对文档。
# 免费视频模型按同一密钥每分钟一次提交做跨 Worker 全局限速，额外留 1 秒余量。
AGNES_VIDEO_SUBMIT_INTERVAL_SECONDS=61
AGNES_VIDEO_SUBMIT_MAX_ATTEMPTS=4
AGNES_VIDEO_SUBMIT_RETRY_SECONDS=2
AGNES_TEXT_MODEL=agnes-2.5-flash
AGNES_VISION_MODEL=agnes-2.5-flash
AGNES_IMAGE_MODEL=agnes-image-2.1-flash
AGNES_VIDEO_MODEL=agnes-video-2.5-flash

# ── 微信开放平台（扫码登录）──
# 获取地址：https://open.weixin.qq.com
# 填入后启用：微信扫码登录/注册
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=http://localhost:5273/auth/wechat/callback

# ── 阿里云短信服务（手机验证码）──
# 获取地址：https://dysms.console.aliyun.com
# 填入后启用：手机验证码登录/注册
# AccessKey 请使用仅授予 dysms:SendSms 权限的 RAM 用户，不要使用主账号密钥。
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=redacted
SMS_TEMPLATE_CODE=redacted
# 模板参数固定为 ${code}；默认 5 分钟有效、60 秒后可重发。
SMS_CODE_TTL_SECONDS=300
SMS_RESEND_INTERVAL_SECONDS=60
SMS_HOURLY_LIMIT=5
SMS_DAILY_LIMIT=10
SMS_MAX_VERIFY_ATTEMPTS=5

# ── 支付宝（会员升级支付）──
# 获取地址：https://open.alipay.com
# 填入后启用：会员升级支付；开票申请记录不依赖支付宝配置
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_SANDBOX=true
ALIPAY_NOTIFY_URL=http://localhost:8000/api/billing/alipay/notify
ALIPAY_RETURN_URL=http://localhost:5273/workspace/account

# ── 数据库 ──
DATABASE_URL=postgresql+asyncpg://openvma:openvma_dev@localhost:5432/openvma
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# ── Redis ──
REDIS_URL=redis://localhost:6379/0
# 非 Docker 开发默认使用 openvma-local；Compose 会覆盖为 openvma-docker，避免两个 Worker 抢同一队列。
CELERY_TASK_DEFAULT_QUEUE=openvma-local

# ── MinIO ──
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=openvma
MINIO_SECRET_KEY=openvma_dev
MINIO_BUCKET=openvma-media
MINIO_SECURE=false
# 生产环境必须配置浏览器可访问的对象存储域名，内部地址仍由 MINIO_ENDPOINT 使用。
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_PUBLIC_SECURE=false
# 浏览器素材上传的单文件上限；1 GiB = 1073741824 字节。
MAX_UPLOAD_SIZE_GB=1

# ── JWT ──
JWT_SECRET=dev-secret-change-in-production

# ── 运行环境与 Web 安全 ──
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5273,http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
RATE_LIMIT_ENABLED=false
API_RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=20
UPLOAD_RATE_LIMIT_PER_MINUTE=30

# 在线供应商临时生成文件允许下载的域名后缀；生产环境按实际返回域名收窄。
AI_MEDIA_ALLOWED_HOSTS=.aliyuncs.com,.aliyun.com,.agnes-ai.cn,.agnes-ai.space

# ── FFmpeg 路径（可选，默认从 PATH 查找）──
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
