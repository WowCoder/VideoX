map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    "" $scheme;
}

map $uri $admin_cache_control {
    default "no-store";
    ~^/assets/ "public, max-age=31536000, immutable";
}

server {
    listen 8080 default_server;
    server_name _;
    server_tokens off;
    location = /nginx-health { access_log off; default_type text/plain; return 200 "ok\n"; }
    location / { return 444; }
}

server {
    listen 8080;
    server_name ${ADMIN_DOMAIN};
    server_tokens off;
    root /usr/share/nginx/html;
    index admin.html;
    client_max_body_size 2m;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
    add_header Cache-Control $admin_cache_control always;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;

    location = /nginx-health { access_log off; default_type text/plain; return 200 "ok\n"; }
    location = /admin.html { try_files $uri =404; }
    location /assets/ { try_files $uri =404; }

    # 后台域名只允许访问后台 API，避免普通用户接口与凭证边界混用。
    location ^~ /api/admin/ {
        proxy_pass http://backend:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    location ^~ /api/ { return 404; }
    location / { try_files $uri $uri/ /admin.html; }
}
