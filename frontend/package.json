{
  "name": "openvma-frontend",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:admin": "vite --mode admin --host 0.0.0.0 --port 5274 --open /admin.html",
    "build": "tsc -b && vite build",
    "build:admin": "tsc -b && vite build --mode admin",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint src --ext ts,tsx",
    "test": "node --experimental-strip-types --test src/**/*.test.ts",
    "build:pages": "vite build --config vite.pages.config.ts",
    "preview:pages": "vite preview --config vite.pages.config.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "read-excel-file": "^5.8.5",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.66.0",
    "vite": "^6.0.0"
  }
}
